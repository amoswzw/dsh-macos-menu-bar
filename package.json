{
  "name": "@amoswzw/dsh-macos-menu-bar",
  "version": "0.1.1",
  "description": "A DeepSeek Harness Desktop plugin for macOS menu bar access and native approvals",
  "author": "Amos W (https://github.com/amoswzw)",
  "type": "module",
  "main": "./index.mjs",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/amoswzw/dsh-macos-menu-bar.git" },
  "homepage": "https://github.com/amoswzw/dsh-macos-menu-bar#readme",
  "keywords": ["dsh-plugin", "deepseek-harness", "macos", "menu-bar", "notch"],
  "os": ["darwin"],
  "publishConfig": { "access": "public" },
  "exports": { ".": "./index.mjs", "./client": "./client.js", "./package.json": "./package.json" },
  "bin": { "dsh-macos-menu-bar": "bin/launch.mjs" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "immediately": true, "inject": [] } },
  "files": ["index.mjs", "client.js", "settings.mjs", "settings.html", "auto-inject.mjs", "injected-main.cjs", "native", "bin", "cordis.patch.yml", "install.sh", "docs/screenshots/*.png", "README.md", "LICENSE"],
  "engines": { "node": ">=22", "dsh": ">=0.2.2-rc.3 <0.2.3" },
  "scripts": { "test": "node --test test/*.test.mjs" }
}
